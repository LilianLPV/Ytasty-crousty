# Copier ce fichier en .env (jamais commité) et remplacer les valeurs.

# Base PostgreSQL locale (docker compose up -d db)
# DB_PORT : port exposé sur votre machine. Si un PostgreSQL est déjà installé
# sur le port 5432, mettez DB_PORT=5433 et le même port dans DATABASE_URL.
DB_PORT=5432
POSTGRES_PASSWORD="Votre_Mot_De_Passe"
DATABASE_URL=postgresql+psycopg://admin:Votre_Mot_De_Passe@localhost:5432/ytasty_db

# Clé de signature des tokens JWT
SECRET_KEY="Votre_Clé_Secrète"

# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# Compte administrateur créé par create_script.py
ADMIN_USERNAME="Votre_Username_Admin"
ADMIN_PASSWORD="Votre_mot_de_passe_admin"
